        <h2 class="text-2xl sm:text-3xl lg:text-5xl sm:mb-20 font-medium">User Reviews</h2>

        {# Data tinggi bar pakai persen (0 - 100) #}
        {% set ratingDist = [
          { score: 1,  percent: 9 },
          { score: 2,  percent: 8 },
          { score: 3,  percent: 7 },
          { score: 4,  percent: 19 },
          { score: 5,  percent: 14 },
          { score: 6,  percent: 16 },
          { score: 7,  percent: 9 },
          { score: 8,  percent: 10 },
          { score: 9,  percent: 2 },
          { score: 10, percent: 6 }
        ] %}

        {# Max percent otomatis dari data tertinggi #}
        {% set maxPercent = 0 %}
        {% for item in ratingDist %}
          {% if item.percent > maxPercent %}
            {% set maxPercent = item.percent %}
          {% endif %}
        {% endfor %}

        {# TOP: rating + distribution #}
        <div class="mt-10 grid gap-8 lg:grid-cols-[360px,1fr] items-center">

          {# LEFT: score #}
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <span class="text-[#FACC15] text-3xl sm:text-4xl leading-none">★</span>
              <p class="text-4xl sm:text-5xl font-semibold leading-none">2.9</p>
              <span class="text-uwais-muted text-base leading-none pb-1">/ 10</span>
            </div>

            {# AVATAR: reviews text moved under avatars #}
            <div class="inline-flex flex-col gap-3">
              <div class="flex -space-x-4">
                <img src="/assets/img/review/adrian.jpg" alt="review-timur" class="h-10 w-10 rounded-full border-2 border-[#111111] object-cover" loading="lazy">
                <img src="/assets/img/review/agustina.jpg" alt="review-timur-2025" class="h-10 w-10 rounded-full border-2 border-[#111111] object-cover" loading="lazy">
                <img src="/assets/img/review/iqbal.jpg" alt="review-film-timur" class="h-10 w-10 rounded-full border-2 border-[#111111] object-cover" loading="lazy">
                {# avatar + #}
                <div class="h-10 w-10 rounded-full border-2 border-[#111111] bg-[#121214] flex items-center justify-center
                            text-2xl font-normal text-uwais-muted">+
                </div>
              </div>
              <p class="text-uwais-muted text-sm sm:text-base">758.8K Reviews</p>
            </div>
          </div>

          {# RIGHT: bars #}
          <div class="w-full" data-review-chart>
            <div class="flex items-end justify-between gap-2 sm:gap-3">
              {% for item in ratingDist %}
                <div class="flex flex-col items-center gap-2 w-full group">
                  <div class="relative w-full mx-auto h-24 sm:h-36 flex items-end">
                    <div
                      class="review-bar-wrap relative w-full"
                      style="height: {{ (item.percent / maxPercent) * 100 }}%;"
                    >
                      <div
                        class="review-tooltip pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 rounded-full bg-[#E31E26] px-2 py-1 text-[11px] sm:text-xs font-medium text-white opacity-0 translate-y-1 transition-all duration-200 whitespace-nowrap"
                      >
                        {{ item.percent }}%
                      </div>

                      <button
                        type="button"
                        class="review-bar absolute inset-x-0 bottom-0 w-full rounded-lg bg-white/10 transition-all duration-300 hover:bg-[#E31E26] hover:shadow-[0_12px_30px_rgba(227,30,38,0.25)] focus:bg-[#E31E26] focus:shadow-[0_12px_30px_rgba(227,30,38,0.25)] outline-none"
                        style="height: 100%;"
                        data-review-bar
                        data-percent="{{ item.percent }}"
                        data-score="{{ item.score }}"
                        aria-label="Rating {{ item.score }} with {{ item.percent }} percent"
                      ></button>
                    </div>
                  </div>

                  <span class="review-score text-sm sm:text-base text-uwais-muted transition-colors duration-200">
                    {{ item.score }}
                  </span>
                </div>
              {% endfor %}
            </div>
          </div>

        </div>

        {# BOTTOM: review cards #}
        <div class="mt-8 grid gap-4 md:grid-cols-3">

          {# CARD 1 #}
          <article class="rounded-2xl bg-white/5 border border-white/5 p-4 sm:p-5">
