            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-3 min-w-0">
                <img src="/assets/img/review/tamajones.jpg" alt="tamajones" class="h-12 w-12 rounded-full object-cover" loading="lazy">

                <div class="min-w-0">
                  <p class="font-medium text-base truncate">tamajones</p>
                  <div class="mt-1 flex items-center gap-2">
                    <span class="text-[#FACC15] text-base leading-none">★</span>
                    <span class="text-sm text-white/90">9/10</span>
                  </div>
                </div>
              </div>

              <span class="text-sm hidden lg:block text-uwais-muted shrink-0">22 Dec 2025</span>
