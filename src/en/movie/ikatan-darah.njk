              </div>
              <p class="text-uwais-muted text-sm sm:text-base">51 K Reviews</p>
            </div>
          </div>

          {# RIGHT: bars #}
          <div class="w-full" data-review-chart>
            <div class="flex items-end justify-between gap-2 sm:gap-3">
              {% for item in ratingDist %}
