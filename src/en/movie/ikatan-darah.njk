                      <div
                        class="review-tooltip pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 rounded-full bg-[#E31E26] px-2 py-1 text-[11px] sm:text-xs font-medium text-white opacity-0 translate-y-1 transition-all duration-200 whitespace-nowrap"
