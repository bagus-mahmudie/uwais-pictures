          href="https://discord.com/" target="_blank" rel="noopener">
          <span class="flex h-14 w-14 items-center justify-center rounded-full bg-white/10 border border-white/10">
            <img src="/assets/img/share/discord.png" alt="Discord" class="h-7 w-7" />
          </span>
          <span class="text-sm">Discord</span>
        </a>

      </div>


      <div class="mt-6">
        <div class="text-white/70 text-sm mb-2">Page Link</div>
        <div class="flex items-center gap-2 rounded-xl border border-white/10 bg-black/30 px-4 py-3">
          <input
            class="w-full bg-transparent text-white/90 outline-none"
            type="text"
            readonly
            data-share-link
          />
          <button
            type="button"
            class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/10 text-white/80 hover:text-white"
            aria-label="Copy link"
            data-share-copy
          >
            <i class="bi bi-clipboard"></i>
          </button>
        </div>

        <p class="mt-2 text-sm text-emerald-300 hidden" data-share-copied>Link copied!</p>
      </div>
    </div>
  </div>

</main>
