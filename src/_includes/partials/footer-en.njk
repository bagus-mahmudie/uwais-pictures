<footer class="border-t border-white/5 bg-[#111111] mt-12 text-uwais-muted">
  <div class="mx-auto max-w-6xl px-4 pt-10 lg:px-0 lg:pt-12">
    {# JOIN NEWSLETTER HEADER #}
    <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
      <h2 class="text-3xl sm:text-4xl md:text-[32px] font-medium text-white">
        Join Our Newsletter
      </h2>

      <form class="flex w-full max-w-xl items-center gap-3">
        <div class="flex h-11 flex-1 items-center rounded-full bg-[#202020] px-4 text-xs text-white/80">
          <span class="mr-3 inline-flex h-9 w-10 items-center justify-center rounded-full text-[18px]">
            <svg class="h-6 w-full" viewBox="0 0 24 24" fill="none">
              <path
                d="M4 6h16v12H4V6zm0 0 8 6 8-6"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <input
            type="email"
            class="h-full w-full bg-transparent text-[16px] text-white placeholder:text-white/40 focus:outline-none"
            placeholder="Email Address"
          >
        </div>
        <button
          type="submit"
          class="inline-flex h-11 items-center justify-center rounded-full bg-[#E31E26] px-6 text-base sm:text-lg text-white tracking-wide hover:bg-uwais-red-soft transition"
        >
          <span class="mr-2">Subscribe</span>
          <span aria-hidden="true">➜</span>
        </button>
      </form>
    </div>

    <div class="mt-10 border-t border-white/10 pt-10">
      <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
        {# LEFT COLUMN: LOGO + TEXT + SOCIAL #}
        <div class="max-w-xs">
          <img
            src="/assets/img/logo-uwais.png"
            alt="{{ site.title }} logo"
            class="mb-7 h-[64px] w-auto"
          >
          <p class="text-[16px] leading-relaxed text-white/70">
            A production house elevating Indonesian action cinema with global collaboration and vision.
          </p>

            <div class="mt-6 flex items-center gap-3">
            {# Email #}
            <a
              href="#"
              class="inline-flex h-[46px] w-[46px] items-center justify-center rounded-full bg-[#E31E26] text-white hover:bg-uwais-red-soft transition"
              aria-label="Email"
            >
              <i class="bi bi-envelope text-[18px]"></i>
            </a>

            {# Instagram #}
            <a
              href="#"
              class="inline-flex h-[46px] w-[46px] items-center justify-center rounded-full bg-[#E31E26] text-white hover:bg-uwais-red-soft transition"
              aria-label="Instagram"
            >
              <i class="bi bi-instagram text-[18px]"></i>
            </a>

            {# Youtube #}
            <a
              href="#"
              class="inline-flex h-[46px] w-[46px] items-center justify-center rounded-full bg-[#E31E26] text-white hover:bg-uwais-red-soft transition"
              aria-label="Youtube"
            >
              <i class="bi bi-youtube text-[18px]"></i>
            </a>

            {# TikTok #}
            <a
              href="#"
              class="inline-flex h-[46px] w-[46px] items-center justify-center rounded-full bg-[#E31E26] text-white hover:bg-uwais-red-soft transition"
              aria-label="TikTok"
            >
              <i class="bi bi-tiktok text-[18px]"></i>
            </a>

            {# X / Twitter #}
            <a
              href="#"
              class="inline-flex h-[46px] w-[46px] items-center justify-center rounded-full bg-[#E31E26] text-white hover:bg-uwais-red-soft transition"
              aria-label="X (Twitter)"
            >
              <i class="bi bi-twitter-x text-[18px]"></i>
            </a>
          </div>

        </div>

        {# RIGHT COLUMNS #}
        <div class="grid flex-1 gap-8 text-xs text-white/80 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <h3 class="mb-5 text-[18px] font-medium text-white">Quick Links</h3>
            <div class="mb-5 h-[2px] w-full bg-white/60"></div>
            <ul class="space-y-6 text-[16px]">
              <li><a href="/en/" class="hover:text-white">Home</a></li>
              <li><a href="/en/about/" class="hover:text-white">About Us</a></li>
              <li><a href="/en/movie/" class="hover:text-white">Our Movie</a></li>
              <li><a href="/en/news/" class="hover:text-white">News</a></li>
              <li><a href="/en/contact/" class="hover:text-white">Contact</a></li>
            </ul>
          </div>

          <div>
            <h3 class="mb-5 text-[18px] font-medium text-white">Film</h3>
            <div class="mb-5 h-[2px] w-full bg-white/60"></div>
            <ul class="space-y-6 text-[16px]">
              <li><a href="/en/movie/timur/" class="hover:text-white">Timur</a></li>
              <li><a href="/en/movie/pasung/" class="hover:text-white">Pasung</a></li>
              <li><a href="/en/movie/ikatan-darah/" class="hover:text-white">Ikatan Darah</a></li>
            </ul>
          </div>

          <div>
            <h3 class="mb-5 text-[18px] font-medium text-white">Support</h3>
            <div class="mb-5 h-[2px] w-full bg-white/60"></div>
            <ul class="space-y-6 text-[16px]">
              <li><a href="/en/faq/" class="hover:text-white">FAQs</a></li>
              <li><a href="/en/terms/" class="hover:text-white">Terms &amp; Conditions</a></li>
              <li><a href="/en/privacy/" class="hover:text-white">Privacy Policy</a></li>
            </ul>
          </div>

          <div>
            <h3 class="mb-5 text-[18px] font-medium text-white">Contact</h3>
            <div class="mb-5 h-[2px] w-full bg-white/60"></div>
            <ul class="space-y-6 text-[16px]">
              <li><a href="mailto:marketing@uwaispictures.id" class="hover:text-white">marketing@uwaispictures.id</a></li>
              <li><span class="text-white/70">+1 678 343 7197</span></li>
            </ul>
          </div>
        </div>
      </div>

      <div class="mt-8 border-t border-white/10 py-4 text-[16px] text-white/60">
        <p>
          All Rights Reserved ©{% year %} Uwais Pictures | Uwais Pictures
        </p>
      </div>
    </div>
  </div>
</footer>
