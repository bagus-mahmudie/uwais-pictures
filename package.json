{
  "name": "uwais-pictures",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npx @11ty/eleventy --serve\" \"npm run watch:css\"",
    "build": "npx @11ty/eleventy && npm run build:css",
    "build:css": "tailwindcss -i ./src/assets/css/main.css -o ./_site/assets/css/main.css --minify",
    "watch:css": "tailwindcss -i ./src/assets/css/main.css -o ./_site/assets/css/main.css --watch --minify"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "@quasibit/eleventy-plugin-sitemap": "^2.2.0"
  }
}
